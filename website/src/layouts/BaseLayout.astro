---
import '../styles/global.css';
import { CHROME_STORE_URL, EXTENSION_VERSION, SITE_URL } from '../lib/extension-meta';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = `${SITE_URL}/og-image.png`,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SEOMarkup.site",
  "url": SITE_URL,
  "description": "SEOMarkup.site helps website owners discover the structured data on any website with a free Chrome extension that reveals what Google can read from web pages.",
  "creator": { "@type": "Organization", "name": "SEOMarkup.site" }
};

const schemas = [websiteSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="SEOMarkup" />

  <!-- Twitter Card -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonical} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={`${SITE_URL}/twitter-image.png`} />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Google Fonts (Poppins) — preconnect then non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" /></noscript>

  <!-- JSON-LD -->
  {schemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Extra head slot for page-specific meta (e.g. article:* OG tags) -->
  <slot name="head" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-006FL60JQY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) { (window as unknown as { dataLayer: unknown[] }).dataLayer.push(args); }
    gtag('js', new Date());
    gtag('config', 'G-006FL60JQY');
  </script>
</head>
<body class="bg-yellow-50 font-sans leading-normal tracking-normal text-gray-800">

  <!-- Header -->
  <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-gray-200">
    <div class="max-w-7xl mx-auto flex items-center justify-between px-5 sm:px-6 lg:px-8 h-14 sm:h-15 md:h-16">
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 group no-underline rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400 active:scale-[0.98] transition-transform duration-150 ease-out-strong">
        <img src="/logo.png" alt="" class="w-8 h-8 sm:w-9 sm:h-9 transition-transform duration-300 ease-overshoot group-hover:-rotate-6" style="transform-origin: 35% 75%" />
        <span class="text-[15px] sm:text-base font-bold text-black tracking-tight">SEOMarkup</span>
        <span class="hidden sm:inline-flex items-center text-[11px] font-mono text-gray-500 tabular-nums ml-1 px-1.5 py-0.5 rounded border border-gray-200 bg-gray-50 leading-none">
          v{EXTENSION_VERSION}
        </span>
      </a>
      <nav class="hidden md:flex items-center gap-6 lg:gap-7 text-[14px] font-medium text-gray-600">
        <a href="/#how-it-works" class="hover:text-black focus-visible:text-black focus-visible:outline-none transition-[color,transform] duration-150 ease-out-strong no-underline active:scale-[0.97]">How it works</a>
        <a href="/#features" class="hover:text-black focus-visible:text-black focus-visible:outline-none transition-[color,transform] duration-150 ease-out-strong no-underline active:scale-[0.97]">Features</a>

        <!-- Resources dropdown -->
        <div class="relative group/resources">
          <a href="/resources/" class="inline-flex items-center gap-0.5 hover:text-black focus-visible:text-black focus-visible:outline-none transition-[color,transform] duration-150 ease-out-strong no-underline active:scale-[0.97]">
            Resources
            <svg class="w-3 h-3 mt-px transition-transform duration-200 group-hover/resources:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="absolute top-full -left-4 pt-3 opacity-0 invisible group-hover/resources:opacity-100 group-hover/resources:visible transition-[opacity,transform] duration-150 ease-out-strong pointer-events-none group-hover/resources:pointer-events-auto z-50 translate-y-1 group-hover/resources:translate-y-0">
            <div class="bg-white rounded-xl shadow-[0_8px_30px_-6px_rgba(0,0,0,0.14)] border border-gray-200 py-1.5 w-[272px] overflow-hidden">
              <a href="/schema-cheat-sheet/" class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 no-underline transition-colors duration-100">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                <div>
                  <p class="text-[13px] font-semibold text-gray-900 leading-snug">Schema.org Cheat Sheet</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">25 most-used types with JSON-LD examples</p>
                </div>
              </a>
              <a href="/how-google-uses-structured-data/" class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 no-underline transition-colors duration-100">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <div>
                  <p class="text-[13px] font-semibold text-gray-900 leading-snug">How Google Uses Structured Data</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">Rankings, eligibility, verification</p>
                </div>
              </a>
              <a href="/ecommerce-structured-data/" class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 no-underline transition-colors duration-100">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <div>
                  <p class="text-[13px] font-semibold text-gray-900 leading-snug">Structured Data for E-commerce</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">Product, Offer, and Review schema</p>
                </div>
              </a>
              <a href="/llms-and-structured-data/" class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 no-underline transition-colors duration-100">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h.01M15 9h.01M9 15h6"/><path d="M9 12h6"/></svg>
                <div>
                  <p class="text-[13px] font-semibold text-gray-900 leading-snug">Do LLMs Benefit from Structured Data?</p>
                  <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">AI-era SEO: real vs. hype</p>
                </div>
              </a>
              <div class="border-t border-gray-100 mx-3 mt-1 pt-1">
                <a href="/resources/" class="flex items-center justify-between px-1 py-2 text-[12px] font-semibold text-yellow-700 hover:text-yellow-900 no-underline transition-colors duration-100">
                  All resources
                  <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href="https://github.com/d%%$/schema-markup" target="_blank" rel="noopener" class="hover:text-black focus-visible:text-black focus-visible:outline-none transition-[color,transform] duration-150 ease-out-strong no-underline inline-flex items-center gap-1.5 active:scale-[0.97]" aria-label="View on GitHub">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.06c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.72-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.07 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.6.23 2.78.11 3.07.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z"/></svg>
          <span class="hidden lg:inline">GitHub</span>
        </a>
      </nav>
      <div class="flex items-center gap-2">
        <a href={CHROME_STORE_URL} target="_blank" rel="noopener"
          class="hidden md:inline-flex items-center gap-2 bg-black hover:bg-gray-800 text-white text-[13px] font-semibold px-3 py-2 rounded-md no-underline transition-[transform,background-color] duration-150 ease-out-strong active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400">
          <span class="inline-flex items-center justify-center bg-white rounded-[2px] w-[16px] h-[16px] flex-shrink-0">
            <svg class="w-2.5 h-2.5" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="11" fill="#fff" />
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#34A853" d="M10.54 28.59l-7.98 6.19C6.51 42.62 14.62 48 24 48c6.47 0 11.9-2.13 15.86-5.81l-7.73-6c-2.13 1.43-4.86 2.31-8.13 2.31-6.26 0-11.57-4.22-13.46-9.91z"/>
              <path fill="#4A90E2" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.54 28.59A14.5 14.5 0 0 1 9.5 24c0-1.6.27-3.14.76-4.59l-7.98-6.19A23.94 23.94 0 0 0 0 24c0 3.88.93 7.54 2.56 10.78l7.98-6.19z"/>
            </svg>
          </span>
          Add to Chrome
        </a>
        <button id="menu-btn" data-state="closed"
          class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-gray-700 hover:text-black rounded-md transition-[transform,color] duration-150 ease-out-strong active:scale-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400 focus:outline-none"
          aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="hamburger" aria-hidden="true">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </span>
        </button>
      </div>
    </div>
    <div id="mobile-menu" data-state="closed"
      class="md:hidden absolute left-0 right-0 top-full border-b border-gray-200 bg-white shadow-[0_8px_24px_-12px_rgba(0,0,0,0.12)]">
      <nav class="px-5 py-2">
        <a href="/#how-it-works" class="block py-3 text-[15px] font-medium text-gray-700 hover:text-black no-underline transition-[color,transform] duration-150 ease-out-strong origin-left active:scale-[0.98]">How it works</a>
        <a href="/#features" class="block py-3 text-[15px] font-medium text-gray-700 hover:text-black no-underline border-t border-gray-100 transition-[color,transform] duration-150 ease-out-strong origin-left active:scale-[0.98]">Features</a>
        <a href="/resources/" class="block py-3 text-[15px] font-medium text-gray-700 hover:text-black no-underline border-t border-gray-100 transition-[color,transform] duration-150 ease-out-strong origin-left active:scale-[0.98]">Resources</a>
        <a href="https://github.com/d%%$/schema-markup" target="_blank" rel="noopener" class="block py-3 text-[15px] font-medium text-gray-700 hover:text-black no-underline border-t border-gray-100 transition-[color,transform] duration-150 ease-out-strong origin-left active:scale-[0.98]">GitHub</a>
      </nav>
      <div class="px-5 pb-4 pt-2">
        <a href={CHROME_STORE_URL} target="_blank" rel="noopener"
          class="block py-3 text-center text-[15px] font-semibold text-white bg-black hover:bg-gray-800 rounded-lg no-underline transition-[transform,background-color] duration-150 ease-out-strong active:scale-[0.98]">
          Add to Chrome — Free
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 text-center space-y-2">
      <p class="text-sm text-gray-400">
        <a href="/resources/" class="hover:text-white">Resources</a> ·
        <a href="/tools/" class="hover:text-white">Tools</a> ·
        <a href="/privacy/" class="hover:text-white">Privacy</a> ·
        <a href="/terms/" class="hover:text-white">Terms</a> ·
        <a href="https://github.com/d%%$/schema-markup" target="_blank" rel="noopener" class="hover:text-white">GitHub</a>
      </p>
      <p class="text-sm text-gray-400">&copy; 2026 SEOMarkup.site · Extension v{EXTENSION_VERSION} · MIT License</p>
    </div>
  </footer>

  <!-- Tally feedback button -->
  <a
    class="fixed bottom-8 right-8 bg-yellow-400 text-black px-4 py-2 rounded-full shadow-lg hover:bg-yellow-500 border-2 border-white font-semibold text-sm z-50"
    href="#tally-open=wvBZED&tally-emoji-text=👋&tally-emoji-animation=wave&tally-auto-close=0"
  >
    Feedback
  </a>

  <script async src="https://tally.so/widgets/embed.js"></script>
  <script>
    function checkAndOpenTallyPopup() {
      if (window.location.hash?.includes('#feedback-open')) {
        if (typeof (window as unknown as { Tally?: { openPopup: (id: string) => void } }).Tally !== 'undefined') {
          (window as unknown as { Tally: { openPopup: (id: string) => void } }).Tally.openPopup('wvBZED');
        } else {
          setTimeout(checkAndOpenTallyPopup, 400);
        }
      }
    }
    window.addEventListener('load', checkAndOpenTallyPopup);

    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const setMenuState = (state: 'open' | 'closed') => {
      menu?.setAttribute('data-state', state);
      btn?.setAttribute('data-state', state);
      btn?.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
    };
    btn?.addEventListener('click', () => {
      const next = menu?.getAttribute('data-state') === 'open' ? 'closed' : 'open';
      setMenuState(next);
    });
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setMenuState('closed'));
    });
  </script>
</body>
</html>
