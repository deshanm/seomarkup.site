---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_STORE_URL, EXTENSION_VERSION, SITE_URL } from '../lib/extension-meta';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is JSON-LD structured data?", "acceptedAnswer": { "@type": "Answer", "text": "JSON-LD is a script block embedded in web pages that tells search engines what the content is: a product, an article, a business. Google uses it to generate rich results in SERPs. SEOMarkup reveals all of it in one click." } },
    { "@type": "Question", "name": "How do I see structured data on a website?", "acceptedAnswer": { "@type": "Answer", "text": "Install SEOMarkup, then click its icon on any page. It instantly reads all JSON-LD blocks and displays them as an interactive tree (no DevTools, no source code)." } },
    { "@type": "Question", "name": "Is SEOMarkup free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. No freemium, no trial, no credit card. Free forever. It's open source under the MIT licence." } },
    { "@type": "Question", "name": "Does SEOMarkup track what websites I visit?", "acceptedAnswer": { "@type": "Answer", "text": "No. The extension uses only the activeTab permission and makes zero network requests. Your browsing data never leaves your browser." } },
    { "@type": "Question", "name": "Does adding structured data improve Google rankings?", "acceptedAnswer": { "@type": "Answer", "text": "Not directly, but it makes your pages eligible for rich results which typically get higher click-through rates. Read our full breakdown in the resources section." } }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SEOMarkup — JSON-LD Structured Data Inspector",
  "applicationCategory": "BrowserApplication",
  "operatingSystem": "Chrome",
  "url": SITE_URL,
  "downloadUrl": CHROME_STORE_URL,
  "description": "Free Chrome extension that instantly reveals all JSON-LD structured data on any webpage.",
  "softwareVersion": EXTENSION_VERSION,
  "datePublished": "2024-01-01",
  "author": { "@type": "Person", "name": "Deshan M" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "screenshot": `${SITE_URL}/screenshot.png`
};

const SCHEMA_PILLS = [
  { label: "Product",             anchor: "product" },
  { label: "Offer",               anchor: "offer" },
  { label: "AggregateRating",     anchor: "aggregaterating" },
  { label: "Review",              anchor: "review" },
  { label: "Article",             anchor: "article" },
  { label: "BlogPosting",         anchor: "blogposting" },
  { label: "FAQPage",             anchor: "faqpage" },
  { label: "HowTo",               anchor: "howto" },
  { label: "LocalBusiness",       anchor: "localbusiness" },
  { label: "Organization",        anchor: "organization" },
  { label: "Person",              anchor: "person" },
  { label: "Event",               anchor: "event" },
  { label: "Recipe",              anchor: "recipe" },
  { label: "VideoObject",         anchor: "videoobject" },
  { label: "Course",              anchor: "course" },
  { label: "Book",                anchor: "book" },
  { label: "JobPosting",          anchor: "jobposting" },
  { label: "BreadcrumbList",      anchor: "breadcrumblist" },
  { label: "WebSite",             anchor: "website" },
  { label: "SoftwareApplication", anchor: "softwareapplication" },
];

const PILL_ICONS: Record<string, string> = {
  Product:             '<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>',
  Offer:               '<path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>',
  AggregateRating:     '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  Review:              '<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>',
  Article:             '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  BlogPosting:         '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  FAQPage:             '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  HowTo:               '<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>',
  LocalBusiness:       '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  Organization:        '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>',
  Person:              '<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  Event:               '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  Recipe:              '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 00-5 5v6c0 1.1.9 2 2 2h3v7"/>',
  VideoObject:         '<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>',
  Course:              '<path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/>',
  Book:                '<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>',
  JobPosting:          '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>',
  BreadcrumbList:      '<path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>',
  WebSite:             '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>',
  SoftwareApplication: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
};

function pillSvg(label: string): string {
  const paths = PILL_ICONS[label] ?? '<circle cx="12" cy="12" r="4"/>';
  return `<svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
}
---

<BaseLayout
  title="JSON-LD Inspector — Free Chrome Extension | SEOMarkup"
  description="SEOMarkup sniffs out every bit of structured data Google reads on any website. Free Chrome extension for JSON-LD inspection, copy, search, and validation."
  jsonLd={[faqSchema, softwareSchema]}
>

<!-- HERO -->
<section class="relative bg-white pt-14 pb-16 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 lg:pt-28 lg:pb-32 overflow-hidden">
  <!-- Subtle dot grid backdrop, faded at edges -->
  <div
    class="absolute inset-0 pointer-events-none opacity-60"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 1px 1px, #e5e7eb 1px, transparent 0); background-size: 24px 24px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);"
  ></div>

  <div class="relative max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 sm:gap-14 lg:gap-16 items-center">
      <div class="lg:col-span-7 hero-stagger">
        <!-- Status meta line -->
        <div class="inline-flex items-center gap-2.5 mb-5 sm:mb-6">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-yellow-500"></span>
          </span>
          <span class="text-[11px] sm:text-xs font-mono uppercase tracking-[0.15em] text-gray-500">
            Chrome Extension · v{EXTENSION_VERSION} · MIT
          </span>
        </div>

        <h1 class="text-[2rem] leading-[1.1] sm:text-5xl sm:leading-[1.04] md:text-[3.5rem] lg:text-[4rem] font-bold text-black tracking-tight text-balance mb-5 sm:mb-6">
          Inspect structured data on any webpage.
        </h1>

        <p class="text-base sm:text-lg md:text-[1.1875rem] text-gray-600 leading-[1.6] mb-8 sm:mb-10 max-w-xl">
          DevTools makes you grep page source for <code class="text-[0.85em] font-mono bg-gray-900 text-yellow-300 px-1.5 py-0.5 rounded whitespace-nowrap">application/ld+json</code>. SEOMarkup just shows it — every block, parsed, searchable, copyable.
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mb-8 sm:mb-10">
          <a href={CHROME_STORE_URL} target="_blank" rel="noopener"
            class="inline-flex items-center justify-center gap-2.5 bg-black hover:bg-gray-800 text-white text-[15px] sm:text-base font-semibold py-3.5 px-6 rounded-lg shadow-sm hover:shadow-md no-underline w-full sm:w-auto transition-[transform,background-color,box-shadow] duration-200 ease-out-strong active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400 focus:outline-none">
            <span class="flex-shrink-0 inline-flex items-center justify-center bg-white rounded-[3px] w-[22px] h-[22px]">
              <svg class="w-3.5 h-3.5" viewBox="0 0 48 48" aria-hidden="true">
                <circle cx="24" cy="24" r="11" fill="#fff" />
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#34A853" d="M10.54 28.59l-7.98 6.19C6.51 42.62 14.62 48 24 48c6.47 0 11.9-2.13 15.86-5.81l-7.73-6c-2.13 1.43-4.86 2.31-8.13 2.31-6.26 0-11.57-4.22-13.46-9.91z"/>
                <path fill="#4A90E2" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.54 28.59A14.5 14.5 0 0 1 9.5 24c0-1.6.27-3.14.76-4.59l-7.98-6.19A23.94 23.94 0 0 0 0 24c0 3.88.93 7.54 2.56 10.78l7.98-6.19z"/>
              </svg>
            </span>
            Add to Chrome — Free
          </a>
          <button
            onclick="document.getElementById('demo-modal').showModal()"
            class="inline-flex items-center justify-center sm:justify-start gap-1.5 text-black text-[15px] sm:text-base font-semibold py-2.5 px-2 hover:underline underline-offset-4 transition-transform duration-150 ease-out-strong active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400 focus:outline-none rounded-md cursor-pointer">
            See it in action
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <!-- Trust line -->
        <div class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2 text-sm">
          <div class="inline-flex items-baseline gap-1.5">
            <span class="font-bold text-black tabular-nums">3,000+</span>
            <span class="text-gray-500">installs</span>
          </div>
          <span class="text-gray-300 select-none" aria-hidden="true">·</span>
          <div class="inline-flex items-center gap-1.5 text-gray-600">
            <svg class="w-4 h-4 text-green-600 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/>
            </svg>
            Zero tracking
          </div>
          <span class="text-gray-300 select-none" aria-hidden="true">·</span>
          <div class="inline-flex items-center gap-1.5 text-gray-600">
            <svg class="w-4 h-4 text-green-600 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.58l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/>
            </svg>
            No account
          </div>
        </div>
      </div>

      <!-- Right: in-browser product mockup -->
      <div class="lg:col-span-5 relative w-full max-w-md mx-auto lg:max-w-none lg:mx-0 hero-mockup">
        <!-- Soft brand glow -->
        <div class="absolute -inset-4 sm:-inset-6 bg-yellow-300/25 sm:bg-yellow-300/30 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>

        <!-- Chrome window frame -->
        <div class="relative bg-white rounded-xl sm:rounded-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.22)] sm:shadow-[0_30px_80px_-20px_rgba(0,0,0,0.28)] border border-gray-200 overflow-hidden">
          <!-- Chrome toolbar -->
          <div class="bg-gray-50 border-b border-gray-200 px-3 py-2.5 flex items-center gap-2">
            <div class="flex gap-1.5 flex-shrink-0" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
            </div>
            <div class="flex-1 bg-white border border-gray-200 rounded-md px-2.5 py-1 text-[11px] text-gray-500 font-mono flex items-center gap-1.5 min-w-0">
              <svg class="w-3 h-3 text-gray-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              <span class="truncate">amazon.com/dp/B08N5WRWNW</span>
            </div>
            <!-- Cat as the extension toolbar icon, lit up because it found schemas -->
            <div class="relative flex-shrink-0 ml-0.5">
              <span class="absolute inset-0 rounded-md bg-yellow-300 blur-md opacity-70 animate-pulse" aria-hidden="true"></span>
              <img src="/logo.png" alt="SEOMarkup extension icon" class="relative w-7 h-7 block" />
              <span class="absolute -top-1.5 -right-1.5 bg-black text-yellow-300 text-[10px] font-mono font-bold leading-none px-1.5 py-1 rounded">7</span>
            </div>
          </div>

          <!-- Popup screenshot — click to open demo modal -->
          <button
            onclick="document.getElementById('demo-modal').showModal()"
            class="group relative w-full block cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-yellow-400"
            aria-label="Watch demo"
          >
            <img
              src="/screenshot.png"
              alt="SEOMarkup popup showing 7 JSON-LD schemas detected on the current page"
              class="w-full block"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/55 transition-colors duration-300 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300 w-14 h-14 rounded-full bg-yellow-400 flex items-center justify-center shadow-xl">
                <svg class="w-6 h-6 text-black ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
              </div>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROBLEM: DevTools workflow vs SEOMarkup workflow -->
<section class="py-20 md:py-28 lg:py-32 bg-gray-50 border-y border-gray-200">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14 sm:mb-16">
      <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500 mb-3">The problem</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-black tracking-tight text-balance leading-[1.1] mb-4">
        Reading schema in DevTools is a chore.
      </h2>
      <p class="text-base sm:text-lg text-gray-600 leading-[1.6] max-w-xl">
        It works, technically. But the workflow is five steps, three tabs, and zero help when something's malformed.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5 md:gap-6">
      <!-- Without -->
      <div class="rounded-2xl bg-white border border-gray-200 p-6 sm:p-8">
        <div class="flex items-center justify-between mb-6">
          <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500">Without SEOMarkup</p>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-red-600">
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="6" r="6"/></svg>
            5 steps
          </span>
        </div>
        <ol class="space-y-4">
          <li class="flex gap-3">
            <span class="font-mono text-xs text-gray-400 tabular-nums pt-0.5 flex-shrink-0">01</span>
            <span class="text-sm text-gray-700 leading-[1.55]">Open DevTools, switch to <span class="font-mono text-xs px-1.5 py-0.5 bg-gray-100 rounded">Elements</span></span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-xs text-gray-400 tabular-nums pt-0.5 flex-shrink-0">02</span>
            <span class="text-sm text-gray-700 leading-[1.55]">Cmd-F for <span class="font-mono text-xs px-1.5 py-0.5 bg-gray-900 text-yellow-300 rounded">application/ld+json</span></span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-xs text-gray-400 tabular-nums pt-0.5 flex-shrink-0">03</span>
            <span class="text-sm text-gray-700 leading-[1.55]">Copy the raw JSON from inside the <span class="font-mono text-xs px-1.5 py-0.5 bg-gray-100 rounded">&lt;script&gt;</span> tag</span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-xs text-gray-400 tabular-nums pt-0.5 flex-shrink-0">04</span>
            <span class="text-sm text-gray-700 leading-[1.55]">Paste into a JSON formatter to make it readable</span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-xs text-gray-400 tabular-nums pt-0.5 flex-shrink-0">05</span>
            <span class="text-sm text-gray-700 leading-[1.55]">Paste again into Google's Rich Results Test. Repeat for every block.</span>
          </li>
        </ol>
        <p class="mt-6 pt-5 border-t border-gray-100 text-xs text-gray-500 leading-relaxed">
          And if it's malformed, DevTools won't tell you. The page still renders.
        </p>
      </div>

      <!-- With -->
      <div class="relative rounded-2xl bg-black p-6 sm:p-8 overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400 to-transparent opacity-60" aria-hidden="true"></div>
        <div class="flex items-center justify-between mb-6">
          <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-yellow-400">With SEOMarkup</p>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-yellow-400">
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="6" r="6"/></svg>
            1 step
          </span>
        </div>
        <ol class="space-y-4">
          <li class="flex gap-3">
            <span class="font-mono text-xs text-yellow-400 tabular-nums pt-0.5 flex-shrink-0">01</span>
            <span class="text-sm text-gray-200 leading-[1.55]">Click the cat. Every JSON-LD block on the page renders as an interactive tree — searchable, copyable, one-click validateable.</span>
          </li>
        </ol>
        <div class="mt-6 pt-5 border-t border-gray-800 grid grid-cols-2 gap-4">
          <div>
            <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500 mb-1.5">Parse errors</p>
            <p class="text-sm text-white">Flagged with the broken snippet highlighted</p>
          </div>
          <div>
            <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500 mb-1.5">Microdata / RDFa</p>
            <p class="text-sm text-white">Detected and labelled, not silently skipped</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="bg-white py-20 md:py-28 lg:py-32">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14 sm:mb-16">
      <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500 mb-3">How it works</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-black tracking-tight text-balance leading-[1.1]">
        Three steps from install to inspection.
      </h2>
    </div>
