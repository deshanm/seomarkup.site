            ["Parse error detection",           true,    false],
            ["Microdata / RDFa detection",      true,    false],
            ["Schema.org deep-links",           true,    false],
            ["Zero tracking",                   true,    true ],
            ["No account required",             true,    true ],
            ["Price",                           "Free",  "Free"],
          ].map(([feature, seo, devtools]) => (
            <tr class="border-b border-gray-900 hover:bg-white/[0.02] transition-colors duration-100">
              <td class="py-3 pr-6 text-[14px] text-gray-300">{feature}</td>
              {[seo, devtools].map((val, i) => (
                <td class="py-3 px-4 text-center">
                  {typeof val === "boolean"
                    ? <span class={`text-lg font-bold ${val ? "text-yellow-400" : "text-gray-700"}`}>{val ? "✓" : "✗"}</span>
                    : <span class={`text-[13px] font-semibold font-mono ${i === 0 ? "text-yellow-400" : "text-gray-500"}`}>{val}</span>
                  }
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

